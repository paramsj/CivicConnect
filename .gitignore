# ==============================================================================
# Master .gitignore for CivicConnect Monorepo
# ==============================================================================

# Environment files - NEVER commit secrets
.env
.env.*
.env.local
.env.*.local
*.env
*.env.*
!*.env.example
!.env.example
!**/.env.example

# Node.js & Javascript Dependencies
node_modules/
**/node_modules/
jspm_packages/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo
package-lock.json.bak

# Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Machine Learning
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
eggs/
.eggs/

# Vite / React / Frontend Build Artifacts
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
.vite/
**/.vite/
.next/
out/
.nuxt/
.cache/
.parcel-cache/
.tailwind/

# Uploads & Temporary Directories
public/temp/*
!public/temp/.gitkeep
*/public/temp/*
!*/public/temp/.gitkeep
backend/public/temp/*
!backend/public/temp/.gitkeep
tmp/
**/tmp/
temp/
**/temp/
uploads/
**/uploads/
*.tmp
pids/
*.pid

# Redis & Local Database Dumps
dump.rdb
*.rdb
*.sqlite
*.sqlite3
public/data/civic_users.json
public/data/Civic_User.csv
backend/src/cache-performance-results.json

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Docker local overrides
docker-compose.override.yml
.docker/
