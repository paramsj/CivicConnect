# ==============================================================================
# CivicConnect — Root Environment Variables
# Used by docker-compose.yml
# ==============================================================================
# Copy this file to .env and fill in your REAL credentials before running.
# NEVER commit the .env file to version control.

# ------------------------------------------------------------------------------
# Gateway Port Configuration
# ------------------------------------------------------------------------------
# The only port exposed to your host machine (HTTP web gateway)
GATEWAY_PORT=80
# MONGO_PORT=27017 # Optional: only needed if using local MongoDB container profile

# ------------------------------------------------------------------------------
# Backend & Database
# ------------------------------------------------------------------------------
NODE_ENV=development
# Paste your MongoDB connection string (Atlas or remote MongoDB URL)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/SIH?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_url_here
REDIS_URL=redis://redis:6379
CORS_ORIGIN=http://localhost,http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# JWT Authentication (CHANGE THESE — do NOT use defaults in production)
# ------------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=CHANGE_ME_to_a_strong_random_string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=CHANGE_ME_to_another_strong_random_string
REFRESH_TOKEN_EXPIRY=10d

# ------------------------------------------------------------------------------
# Clerk Authentication (from https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Cloudinary Image Storage (from https://console.cloudinary.com)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# Frontend API URL (relative path works with the Nginx gateway)
# ------------------------------------------------------------------------------
VITE_API_URL=/api/v1
